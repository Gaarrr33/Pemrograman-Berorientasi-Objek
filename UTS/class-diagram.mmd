        +getAlamat() String
        +setAlamat(alamat: String) void
        +tampilkanInfo() void
        +toString() String
    }

    class Kunjungan {
        <<Comparable~Kunjungan~>>
        -idKunjungan: String
        -nomorAntrean: int
        -keluhan: String
        -prioritas: int
        -status: String
        +Kunjungan(id, noAntre, pasien, tm, keluhan, prioritas)
        +getIdKunjungan() String
