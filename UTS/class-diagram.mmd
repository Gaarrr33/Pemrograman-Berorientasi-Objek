    class PelayananMedis {
        <<interface>>
        +beriPelayanan(pasien: Pasien, keluhan: String) void*
        +getPeran() String*
    }

    class TenagaMedis {
        <<abstract>>
        -idTenagaMedis: String
        -nama: String
        -spesialisasi: String
        +TenagaMedis(idTenagaMedis, nama, spesialisasi)
        +getIdTenagaMedis() String
        +setIdTenagaMedis(id: String) void
        +getNama() String
        +setNama(nama: String) void
        +getSpesialisasi() String
        +setSpesialisasi(spesialisasi: String) void
        +beriPelayanan(pasien: Pasien, keluhan: String) void*
        +tampilkanProfil() void
        +toString() String
    }

    class Dokter {
        -nomorSip: String
        -biayaKonsultasi: double
        +Dokter(id, nama, spesialisasi, nomorSip, biaya)
        +getNomorSip() String
