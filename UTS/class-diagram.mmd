    class Pasien {
        -idPasien: String
        -nama: String
        -usia: int
        -jenisKelamin: String
        -alamat: String
        +Pasien(id, nama, usia, jk, alamat)
        +getIdPasien() String
        +setIdPasien(id: String) void
        +getNama() String
        +setNama(nama: String) void
        +getUsia() int
        +setUsia(usia: int) void
        +getJenisKelamin() String
