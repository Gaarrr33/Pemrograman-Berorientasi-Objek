        +getBiayaKonsultasi() double
        +setBiayaKonsultasi(biaya: double) void
        +getPeran() String
        +beriPelayanan(pasien: Pasien, keluhan: String) void
    }

    class Perawat {
        -shiftKerja: String
        -ruangTugas: String
