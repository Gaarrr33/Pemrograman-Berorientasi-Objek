        +getStatus() String
        +setStatus(s: String) void
        +getTeksPrioritas() String
        +prosesPelayanan() void
        +compareTo(other: Kunjungan) int
        +tampilkanBarisTabel() void
    }

    class Klinik {
        -namaKlinik: String
        -alamat: String
        -counterAntrean: int
        -counterKunjungan: int
        +Klinik(nama, alamat)
